<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX6"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="Lighting" referent="RBX7"><Properties><string name="Name">Lighting</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX10"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX9"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Zentrale Einstellungen des Spiels.
-- Alles, was man zum Ausbalancieren braucht (Preise, Geschwindigkeiten, Eier), steht hier.

local Config = {}

-- ---------------------------------------------------------------------------
-- Karte
-- ---------------------------------------------------------------------------
Config.LOBBY_MIN_X = -150
Config.LOBBY_MAX_X = 150
Config.LOBBY_MIN_Z = -200
Config.LOBBY_MAX_Z = 100

Config.SLOPE_START_Z = 100 -- ab hier beginnt der Berg (Richtung +Z geht es bergauf)
Config.SLOPE_HALF_WIDTH = 100 -- halbe Pistenbreite
Config.SLOPE_RUN = 220 -- waagrechte Laenge eines Hangstuecks
Config.SLOPE_RISE = 80 -- Hoehengewinn eines Hangstuecks
Config.TERRACE_LENGTH = 70 -- Laenge der flachen Zone mit den Nestern

-- ---------------------------------------------------------------------------
-- Spieler
-- ---------------------------------------------------------------------------
Config.MAX_SPEED_LEVEL = 20
Config.BASE_SLOTS = 8
Config.SELL_SECONDS = 30 -- Verkaufswert = Einkommen pro Sekunde * dieser Wert
Config.LOCK_DURATION = 60 -- Sekunden, die eine Basis gesperrt bleibt
Config.NEST_RESPAWN = 15 -- Sekunden, bis in einem leeren Nest ein neues Ei liegt
Config.STUN_TIME = 2.5 -- Sekunden Betaeubung, wenn die Mutter einen erwischt
Config.MOTHER_WAKE_TIME = 1.2 -- Vorsprung, bevor die Mutter losrennt
Config.RECAPTURE_RADIUS = 7 -- Abstand, in dem ein Besitzer sein Ei zurueckholt

function Config.walkSpeed(level)
	return 16 + level
end

function Config.skiSpeed(level)
	return 36 + 4 * level
end

function Config.upgradeCost(level)
	return math.floor(100 * (1.55 ^ level))
end

function Config.rebirthCost(rebirths)
	return 1000000 * (4 ^ rebirths)
end

function Config.incomeMultiplier(rebirths)
	return 1 + 0.5 * rebirths
end

-- ---------------------------------------------------------------------------
-- Zonen (von unten nach oben). Je hoeher, desto wertvoller die Eier und
-- desto schneller die Mutter.
-- income = Geld pro Sekunde, weight = Haeufigkeit im Nest.
-- ---------------------------------------------------------------------------
Config.ZONES = {
	{
		name = "Pine Valley",
		color = Color3.fromRGB(120, 200, 120),
		mother = { name = "Snow Hen", speed = 30, size = 1.0, color = Color3.fromRGB(245, 245, 245) },
		eggs = {
			{ id = "snow", name = "Snow Egg", income = 2, weight = 60, color = Color3.fromRGB(240, 240, 250) },
			{ id = "pine", name = "Pine Egg", income = 4, weight = 30, color = Color3.fromRGB(90, 160, 90) },
			{ id = "berry", name = "Frostberry Egg", income = 8, weight = 10, color = Color3.fromRGB(200, 70, 110) },
		},
	},
	{
		name = "Frozen Lake",
		color = Color3.fromRGB(110, 190, 240),
		mother = { name = "Ice Goose", speed = 44, size = 1.3, color = Color3.fromRGB(170, 220, 255) },
		eggs = {
			{ id = "ice", name = "Ice Egg", income = 15, weight = 60, color = Color3.fromRGB(150, 210, 255) },
			{ id = "pearl", name = "Pearl Egg", income = 30, weight = 30, color = Color3.fromRGB(250, 235, 255) },
			{ id = "aqua", name = "Deep Aqua Egg", income = 60, weight = 10, color = Color3.fromRGB(0, 150, 200) },
		},
	},
	{
		name = "Crystal Ridge",
		color = Color3.fromRGB(190, 130, 255),
		mother = { name = "Crystal Owl", speed = 60, size = 1.6, color = Color3.fromRGB(190, 140, 255) },
		eggs = {
			{ id = "amethyst", name = "Amethyst Egg", income = 120, weight = 60, color = Color3.fromRGB(160, 90, 220) },
			{ id = "ruby", name = "Ruby Egg", income = 240, weight = 30, color = Color3.fromRGB(220, 40, 60) },
			{ id = "prism", name = "Prism Egg", income = 500, weight = 10, color = Color3.fromRGB(255, 120, 230), neon = true },
		},
	},
	{
		name = "Storm Cliffs",
		color = Color3.fromRGB(255, 190, 70),
		mother = { name = "Thunder Hawk", speed = 80, size = 2.0, color = Color3.fromRGB(90, 90, 110) },
		eggs = {
			{ id = "storm", name = "Storm Egg", income = 1000, weight = 60, color = Color3.fromRGB(90, 100, 130) },
			{ id = "bolt", name = "Lightning Egg", income = 2000, weight = 30, color = Color3.fromRGB(255, 230, 60), neon = true },
			{ id = "gold", name = "Golden Egg", income = 4000, weight = 10, color = Color3.fromRGB(255, 190, 0), neon = true },
		},
	},
	{
		name = "Dragon Summit",
		color = Color3.fromRGB(255, 80, 80),
		mother = { name = "Frost Dragon", speed = 104, size = 2.6, color = Color3.fromRGB(60, 200, 220) },
		eggs = {
			{ id = "dragon", name = "Dragon Egg", income = 8000, weight = 60, color = Color3.fromRGB(200, 50, 50) },
			{ id = "aurora", name = "Aurora Egg", income = 16000, weight = 30, color = Color3.fromRGB(80, 255, 180), neon = true },
			{ id = "void", name = "Void Egg", income = 40000, weight = 10, color = Color3.fromRGB(120, 0, 255), neon = true },
		},
	},
}

Config.ZONE_COUNT = #Config.ZONES

-- Nachschlagetabelle: Ei-Kennung -> Ei-Daten (inklusive Zonennummer)
Config.EGGS_BY_ID = {}
for zoneIndex, zone in ipairs(Config.ZONES) do
	for _, egg in ipairs(zone.eggs) do
		egg.zone = zoneIndex
		Config.EGGS_BY_ID[egg.id] = egg
	end
end

-- ---------------------------------------------------------------------------
-- Gelaendeform. Der Berg ist eine Treppe aus Haengen und flachen Zonen;
-- diese Funktion liefert die Bodenhoehe fuer jede Z-Position.
-- ---------------------------------------------------------------------------
function Config.groundHeight(z)
	local s = z - Config.SLOPE_START_Z
	if s <= 0 then
		return 0
	end
	local segment = Config.SLOPE_RUN + Config.TERRACE_LENGTH
	local index = math.floor(s / segment)
	if index >= Config.ZONE_COUNT then
		return Config.ZONE_COUNT * Config.SLOPE_RISE
	end
	local rest = s - index * segment
	if rest >= Config.SLOPE_RUN then
		return (index + 1) * Config.SLOPE_RISE
	end
	return index * Config.SLOPE_RISE + rest / Config.SLOPE_RUN * Config.SLOPE_RISE
end

-- Anfang (Z) und Hoehe (Y) der flachen Zone mit der Nummer zoneIndex
function Config.terraceStart(zoneIndex)
	local segment = Config.SLOPE_RUN + Config.TERRACE_LENGTH
	local z = Config.SLOPE_START_Z + (zoneIndex - 1) * segment + Config.SLOPE_RUN
	return z, zoneIndex * Config.SLOPE_RISE
end

Config.MOUNTAIN_END_Z = Config.SLOPE_START_Z + Config.ZONE_COUNT * (Config.SLOPE_RUN + Config.TERRACE_LENGTH)

-- Zahlen kurz darstellen: 1500 -> 1.5K
function Config.formatNumber(n)
	n = math.floor(n)
	local units = { "", "K", "M", "B", "T", "Qa" }
	local unit = 1
	local value = n
	while value >= 1000 and unit < #units do
		value = value / 1000
		unit = unit + 1
	end
	if unit == 1 then
		return tostring(n)
	end
	return string.format("%.1f%s", value, units[unit])
end

return Config
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX13"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX12"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX11"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Startpunkt des Servers: baut die Welt und verbindet alle Teile miteinander.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))
local Lift = require(script.Parent:WaitForChild("Lift"))
local Bases = require(script.Parent:WaitForChild("Bases"))
local Data = require(script.Parent:WaitForChild("Data"))
local Eggs = require(script.Parent:WaitForChild("Eggs"))

-- ---------------------------------------------------------------------------
-- Verbindungen zwischen Server und Spieler
-- ---------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
local buySpeedRemote = Instance.new("RemoteEvent")
buySpeedRemote.Name = "BuySpeed"
buySpeedRemote.Parent = remotes
local rebirthRemote = Instance.new("RemoteEvent")
rebirthRemote.Name = "Rebirth"
rebirthRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

local function notify(player, text, kind)
	if player and player.Parent then
		notifyRemote:FireClient(player, text, kind or "info")
	end
end

Bases.notify = notify
Eggs.notify = notify
Data.collectEggs = Eggs.listFor

-- ---------------------------------------------------------------------------
-- Welt aufbauen
-- ---------------------------------------------------------------------------
local map = World.build()
Lift.build(map)
Bases.build(map)
Eggs.build(map)

-- ---------------------------------------------------------------------------
-- Schi an den Fuessen (nur auf dem Berg sichtbar)
-- ---------------------------------------------------------------------------
local function addSkis(character)
	local feet = {
		character:FindFirstChild("LeftFoot") or character:FindFirstChild("Left Leg"),
		character:FindFirstChild("RightFoot") or character:FindFirstChild("Right Leg"),
	}
	for _, foot in pairs(feet) do
		local ski = Instance.new("Part")
		ski.Name = "Ski"
		ski.Size = Vector3.new(0.6, 0.15, 5)
		ski.Color = Color3.fromRGB(230, 60, 60)
		ski.Material = Enum.Material.SmoothPlastic
		ski.CanCollide = false
		ski.CanTouch = false
		ski.CanQuery = false
		ski.Massless = true
		ski.Transparency = 1
		ski.CFrame = foot.CFrame * CFrame.new(0, -foot.Size.Y / 2 - 0.08, -0.8)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = foot
		weld.Part1 = ski
		weld.Parent = ski
		ski.Parent = character
	end
end

local function updateSkis()
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local onMountain = root.Position.Z > Config.SLOPE_START_Z
			local transparency = onMountain and 0 or 1
			for _, child in ipairs(character:GetChildren()) do
				if child.Name == "Ski" and child.Transparency ~= transparency then
					child.Transparency = transparency
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Spieler kommen und gehen
-- ---------------------------------------------------------------------------
local function onCharacterAdded(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	humanoid.WalkSpeed = player:GetAttribute("WalkSpeed") or 16
	humanoid.Died:Connect(function()
		Eggs.drop(player)
	end)
	task.wait(0.5) -- kurz warten, bis alle Koerperteile da sind
	if character.Parent then
		addSkis(character)
	end
end

local function onPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local profile = Data.load(player)
	if not player.Parent then
		Data.release(player)
		return
	end

	local base = Bases.assign(player)
	if base then
		Eggs.restore(player, profile.Eggs)
	else
		notify(player, "All bases are taken - set the server size to 8 players.", "bad")
	end

	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
	notify(player, "Welcome! Ride the ski lift, steal an egg and ski back down.", "info")
end

local function onPlayerRemoving(player)
	Eggs.drop(player)
	Data.save(player)
	Eggs.clearBase(player)
	Eggs.forget(player)
	Bases.release(player)
	Data.release(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

-- ---------------------------------------------------------------------------
-- Kaeufe
-- ---------------------------------------------------------------------------
local lastRequest = {}
local function tooFast(player)
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < 0.15 then
		return true
	end
	lastRequest[player] = now
	return false
end
Players.PlayerRemoving:Connect(function(player)
	lastRequest[player] = nil
end)

buySpeedRemote.OnServerEvent:Connect(function(player)
	if tooFast(player) then
		return
	end
	local ok, message = Data.buySpeed(player)
	notify(player, message, ok and "good" or "bad")
end)

rebirthRemote.OnServerEvent:Connect(function(player)
	if tooFast(player) then
		return
	end
	local ok, message = Data.rebirth(player)
	if ok then
		Eggs.drop(player)
		Eggs.clearBase(player)
	end
	notify(player, message, ok and "good" or "bad")
end)

-- ---------------------------------------------------------------------------
-- Spielschleife
-- ---------------------------------------------------------------------------
local skiTimer = 0
RunService.Heartbeat:Connect(function(dt)
	Lift.update(dt)
	Eggs.update(dt)
	skiTimer = skiTimer + dt
	if skiTimer >= 0.3 then
		skiTimer = 0
		updateSkis()
	end
end)

-- Regelmaessig und beim Herunterfahren speichern
task.spawn(function()
	while true do
		task.wait(120)
		Data.saveAll()
	end
end)

game:BindToClose(function()
	Data.saveAll()
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- Baut die gesamte Karte beim Serverstart: Lobby, Berg, Zonen, Dekoration.
-- Dadurch funktioniert das Spiel auch in einem voellig leeren Platz.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local World = {}

-- Kleine Hilfsfunktion: Instanz anlegen, Eigenschaften setzen, einhaengen.
function World.make(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		instance[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local make = World.make

-- Verankertes Bauteil mit sinnvollen Standardwerten
function World.part(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		p[key] = value
	end
	p.Parent = parent
	return p
end

-- Schwebender Text ueber einem Bauteil. Gibt das TextLabel zurueck.
function World.billboard(parent, text, width, height, offsetY, color)
	local gui = make("BillboardGui", {
		Size = UDim2.new(width, 0, height, 0),
		StudsOffset = Vector3.new(0, offsetY, 0),
		MaxDistance = 250,
		AlwaysOnTop = false,
		LightInfluence = 0,
	}, parent)
	local label = make("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = color or Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
	}, gui)
	return label
end

local SNOW = Color3.fromRGB(245, 248, 255)

local function buildLobby(folder)
	local width = Config.LOBBY_MAX_X - Config.LOBBY_MIN_X
	local depth = Config.LOBBY_MAX_Z - Config.LOBBY_MIN_Z
	local centerZ = (Config.LOBBY_MAX_Z + Config.LOBBY_MIN_Z) / 2

	World.part({
		Name = "LobbyFloor",
		Size = Vector3.new(width, 4, depth),
		Position = Vector3.new(0, -2, centerZ),
		Color = SNOW,
		Material = Enum.Material.Snow,
	}, folder)

	-- Mittelweg, damit die Lobby nicht nur weiss ist
	World.part({
		Name = "Path",
		Size = Vector3.new(40, 0.2, depth),
		Position = Vector3.new(0, 0.05, centerZ),
		Color = Color3.fromRGB(150, 160, 175),
		Material = Enum.Material.Slate,
		CanCollide = false,
	}, folder)

	make("SpawnLocation", {
		Name = "Spawn",
		Anchored = true,
		Size = Vector3.new(14, 1, 14),
		Position = Vector3.new(0, 0.5, -50),
		Color = Color3.fromRGB(80, 170, 255),
		Material = Enum.Material.Neon,
		Duration = 0,
		Neutral = true,
		TopSurface = Enum.SurfaceType.Smooth,
	}, folder)

	-- Unsichtbare Begrenzungen der Lobby
	local wallHeight = 120
	local function wall(size, position)
		World.part({
			Name = "Barrier",
			Size = size,
			Position = position,
			Transparency = 1,
		}, folder)
	end
	wall(Vector3.new(2, wallHeight, depth), Vector3.new(Config.LOBBY_MIN_X - 1, wallHeight / 2, centerZ))
	wall(Vector3.new(2, wallHeight, depth), Vector3.new(Config.LOBBY_MAX_X + 1, wallHeight / 2, centerZ))
	wall(Vector3.new(width, wallHeight, 2), Vector3.new(0, wallHeight / 2, Config.LOBBY_MIN_Z - 1))
	local sideWidth = Config.LOBBY_MAX_X - Config.SLOPE_HALF_WIDTH
	local sideCenter = Config.SLOPE_HALF_WIDTH + sideWidth / 2
	wall(Vector3.new(sideWidth, wallHeight, 2), Vector3.new(sideCenter, wallHeight / 2, Config.LOBBY_MAX_Z + 1))
	wall(Vector3.new(sideWidth, wallHeight, 2), Vector3.new(-sideCenter, wallHeight / 2, Config.LOBBY_MAX_Z + 1))

	-- Erklaertafel beim Spawn
	local board = World.part({
		Name = "HowToPlay",
		Size = Vector3.new(34, 16, 1),
		Position = Vector3.new(0, 11, -90),
		Color = Color3.fromRGB(40, 50, 80),
	}, folder)
	World.part({
		Name = "BoardPost",
		Size = Vector3.new(2, 4, 1),
		Position = Vector3.new(0, 2, -90),
		Color = Color3.fromRGB(90, 70, 50),
		Material = Enum.Material.Wood,
	}, folder)
	local surface = make("SurfaceGui", {
		Face = Enum.NormalId.Back,
		CanvasSize = Vector2.new(680, 320),
	}, board)
	make("TextLabel", {
		Size = UDim2.new(1, -30, 1, -30),
		Position = UDim2.new(0, 15, 0, 15),
		BackgroundTransparency = 1,
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = Color3.new(1, 1, 1),
		Text = "HOW TO PLAY\n1. Ride the ski lift up the mountain\n2. Steal an egg from a nest\n3. Ski down - the mother will chase you!\n4. Bring the egg to your base to earn cash\n5. Buy speed to reach higher zones",
	}, surface)
end

local function buildMountain(folder)
	local width = Config.SLOPE_HALF_WIDTH * 2
	local thickness = 6
	local run = Config.SLOPE_RUN
	local rise = Config.SLOPE_RISE
	local length = math.sqrt(run * run + rise * rise)

	for zoneIndex = 1, Config.ZONE_COUNT do
		local terraceZ, terraceY = Config.terraceStart(zoneIndex)
		local z0 = terraceZ - run
		local y0 = terraceY - rise

		-- Hang
		local mid = Vector3.new(0, (y0 + terraceY) / 2, (z0 + terraceZ) / 2)
		local top = Vector3.new(0, terraceY, terraceZ)
		World.part({
			Name = "Slope" .. zoneIndex,
			Size = Vector3.new(width, thickness, length + 0.5),
			CFrame = CFrame.lookAt(mid, top) * CFrame.new(0, -thickness / 2, 0),
			Color = SNOW,
			Material = Enum.Material.Snow,
		}, folder)

		-- Flache Zone mit den Nestern
		local zone = Config.ZONES[zoneIndex]
		World.part({
			Name = "Terrace" .. zoneIndex,
			Size = Vector3.new(width, thickness, Config.TERRACE_LENGTH),
			Position = Vector3.new(0, terraceY - thickness / 2, terraceZ + Config.TERRACE_LENGTH / 2),
			Color = SNOW,
			Material = Enum.Material.Snow,
		}, folder)

		-- Farbstreifen, damit man die Zone von weitem erkennt
		World.part({
			Name = "ZoneStripe" .. zoneIndex,
			Size = Vector3.new(width, 0.2, 4),
			Position = Vector3.new(0, terraceY + 0.05, terraceZ + 2),
			Color = zone.color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, folder)

		-- Zonenschild
		local post = World.part({
			Name = "ZoneSign" .. zoneIndex,
			Size = Vector3.new(1, 12, 1),
			Position = Vector3.new(90, terraceY + 6, terraceZ + Config.TERRACE_LENGTH - 6),
			Color = Color3.fromRGB(90, 70, 50),
			Material = Enum.Material.Wood,
		}, folder)
		World.billboard(post, "ZONE " .. zoneIndex .. "\n" .. zone.name, 26, 9, 11, zone.color)
	end

	-- Unsichtbare Seitenwaende und Rueckwand, damit niemand vom Berg faellt
	local mountainLength = Config.MOUNTAIN_END_Z - Config.SLOPE_START_Z
	local topY = Config.ZONE_COUNT * rise
	local wallHeight = topY + 200
	local centerZ = Config.SLOPE_START_Z + mountainLength / 2
	for _, side in ipairs({ -1, 1 }) do
		World.part({
			Name = "MountainWall",
			Size = Vector3.new(2, wallHeight, mountainLength),
			Position = Vector3.new(side * (Config.SLOPE_HALF_WIDTH + 1), wallHeight / 2 - 20, centerZ),
			Transparency = 1,
		}, folder)
	end
	World.part({
		Name = "MountainBackWall",
		Size = Vector3.new(width, 260, 2),
		Position = Vector3.new(0, topY + 110, Config.MOUNTAIN_END_Z + 1),
		Transparency = 1,
	}, folder)

	-- Sichtbare Felswand hinter dem Gipfel
	World.part({
		Name = "Peak",
		Size = Vector3.new(width, 90, 30),
		Position = Vector3.new(0, topY + 30, Config.MOUNTAIN_END_Z + 17),
		Color = Color3.fromRGB(120, 125, 140),
		Material = Enum.Material.Rock,
	}, folder)

	-- Baeume am linken Pistenrand (rechts faehrt der Lift)
	local treeFolder = make("Folder", { Name = "Trees" }, folder)
	local z = Config.SLOPE_START_Z + 20
	local toggle = false
	while z < Config.MOUNTAIN_END_Z - 10 do
		local y = Config.groundHeight(z)
		local x = -(Config.SLOPE_HALF_WIDTH - (toggle and 5 or 9))
		World.part({
			Name = "Trunk",
			Size = Vector3.new(1.5, 6, 1.5),
			Position = Vector3.new(x, y + 3, z),
			Color = Color3.fromRGB(100, 70, 45),
			Material = Enum.Material.Wood,
			CanCollide = false,
		}, treeFolder)
		World.part({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(9, 9, 9),
			Position = Vector3.new(x, y + 9, z),
			Color = Color3.fromRGB(40, 110, 70),
			Material = Enum.Material.Grass,
			CanCollide = false,
		}, treeFolder)
		World.part({
			Name = "SnowCap",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(6, 6, 6),
			Position = Vector3.new(x, y + 12.5, z),
			Color = SNOW,
			Material = Enum.Material.Snow,
			CanCollide = false,
		}, treeFolder)
		toggle = not toggle
		z = z + 38
	end
end

function World.build()
	local folder = make("Folder", { Name = "Map" }, workspace)

	-- Eine eventuell vorhandene Standard-Bodenplatte wuerde stoeren
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	buildLobby(folder)
	buildMountain(folder)

	Lighting.ClockTime = 13.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(150, 160, 180)
	Lighting.OutdoorAmbient = Color3.fromRGB(160, 170, 190)

	return folder
end

return World
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Lift</string><ProtectedString name="Source"><![CDATA[-- Der Schilift: Sessel fahren in einer Endlosschleife den Berg hinauf und wieder hinunter.
-- Einsteigen: unten auf die gruene Flaeche stellen. Aussteigen: jederzeit springen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))

local Lift = {}

local LIFT_SPEED = 55 -- Studs pro Sekunde
local CHAIR_COUNT = 16
local UP_X = 60 -- Spur bergauf
local DOWN_X = 72 -- Spur bergab
local CABLE_HEIGHT = 16 -- Hoehe der Sessel ueber dem Boden
local BOARD_Z = 40 -- Einstieg in der Lobby
local BOARD_HEIGHT = 3.2
local BOARD_RADIUS = 7

local points = {} -- Eckpunkte der Schleife
local cumulative = {} -- Streckenlaenge bis zu jedem Eckpunkt
local totalLength = 0
local topDistance = 0 -- Streckenposition der Bergstation
local chairs = {}

local function buildPath()
	local up = {}
	table.insert(up, Vector3.new(UP_X, BOARD_HEIGHT, BOARD_Z))
	table.insert(up, Vector3.new(UP_X, CABLE_HEIGHT, Config.SLOPE_START_Z))
	for zoneIndex = 1, Config.ZONE_COUNT do
		local terraceZ, terraceY = Config.terraceStart(zoneIndex)
		table.insert(up, Vector3.new(UP_X, terraceY + CABLE_HEIGHT, terraceZ))
		if zoneIndex < Config.ZONE_COUNT then
			table.insert(up, Vector3.new(UP_X, terraceY + CABLE_HEIGHT, terraceZ + Config.TERRACE_LENGTH))
		else
			table.insert(up, Vector3.new(UP_X, terraceY + CABLE_HEIGHT, terraceZ + Config.TERRACE_LENGTH - 25))
		end
	end

	for _, p in ipairs(up) do
		table.insert(points, p)
	end
	local topIndex = #points
	for i = #up, 1, -1 do
		local p = up[i]
		table.insert(points, Vector3.new(DOWN_X, p.Y, p.Z))
	end

	totalLength = 0
	for i = 1, #points do
		cumulative[i] = totalLength
		local nextPoint = points[i % #points + 1]
		totalLength = totalLength + (nextPoint - points[i]).Magnitude
	end
	topDistance = cumulative[topIndex]
end

-- Position und Fahrtrichtung fuer eine Streckenposition
local function sample(distance)
	distance = distance % totalLength
	local count = #points
	for i = count, 1, -1 do
		if distance >= cumulative[i] then
			local a = points[i]
			local b = points[i % count + 1]
			local segment = (b - a).Magnitude
			local alpha = 0
			if segment > 0 then
				alpha = (distance - cumulative[i]) / segment
			end
			return a + (b - a) * alpha, b - a
		end
	end
	return points[1], points[2] - points[1]
end

local function buildDecoration(folder)
	local cableColor = Color3.fromRGB(40, 40, 45)
	local count = #points
	for i = 1, count do
		local a = points[i] + Vector3.new(0, 9, 0)
		local b = points[i % count + 1] + Vector3.new(0, 9, 0)
		local length = (b - a).Magnitude
		if length > 0.1 then
			World.part({
				Name = "Cable",
				Size = Vector3.new(0.4, 0.4, length),
				CFrame = CFrame.lookAt((a + b) / 2, b),
				Color = cableColor,
				CanCollide = false,
			}, folder)
		end
	end

	-- Stuetzen zwischen den beiden Spuren
	local pylonX = (UP_X + DOWN_X) / 2
	for i = 1, count / 2 do
		local p = points[i]
		local ground = Config.groundHeight(p.Z)
		local top = p.Y + 9
		local height = top - ground
		if height > 2 then
			World.part({
				Name = "Pylon",
				Size = Vector3.new(1.6, height, 1.6),
				Position = Vector3.new(pylonX, ground + height / 2, p.Z),
				Color = Color3.fromRGB(70, 75, 90),
				Material = Enum.Material.Metal,
				CanCollide = false,
			}, folder)
			World.part({
				Name = "PylonArm",
				Size = Vector3.new(DOWN_X - UP_X + 3, 0.8, 0.8),
				Position = Vector3.new(pylonX, top, p.Z),
				Color = Color3.fromRGB(70, 75, 90),
				Material = Enum.Material.Metal,
				CanCollide = false,
			}, folder)
		end
	end

	-- Einstiegsflaeche
	local pad = World.part({
		Name = "BoardingPad",
		Size = Vector3.new(BOARD_RADIUS * 2, 0.3, BOARD_RADIUS * 2),
		Position = Vector3.new(UP_X, 0.1, BOARD_Z),
		Color = Color3.fromRGB(60, 220, 110),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, folder)
	World.billboard(pad, "SKI LIFT\nstand here", 16, 6, 14, Color3.fromRGB(120, 255, 160))
end

local function buildChair(folder, index)
	local model = Instance.new("Model")
	model.Name = "Chair" .. index

	local seat = World.make("Seat", {
		Name = "Seat",
		Anchored = true,
		Size = Vector3.new(4, 1, 3),
		Color = Color3.fromRGB(220, 60, 60),
		Material = Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
		CFrame = CFrame.new(0, 0, 0),
	}, model)
	World.part({
		Name = "Back",
		Size = Vector3.new(4, 3, 0.5),
		CFrame = CFrame.new(0, 1.5, 1.6),
		Color = Color3.fromRGB(200, 50, 50),
		CanCollide = false,
	}, model)
	World.part({
		Name = "Hanger",
		Size = Vector3.new(0.4, 8, 0.4),
		CFrame = CFrame.new(0, 5, 1.8),
		Color = Color3.fromRGB(60, 60, 70),
		Material = Enum.Material.Metal,
		CanCollide = false,
	}, model)

	model.PrimaryPart = seat
	model.Parent = folder

	-- Mit einem Ei in der Hand darf man nicht bequem mit dem Lift fliehen
	seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		local humanoid = seat.Occupant
		if not humanoid then
			return
		end
		local player = Players:GetPlayerFromCharacter(humanoid.Parent)
		if player and player:GetAttribute("Carrying") then
			task.defer(function()
				humanoid.Sit = false
			end)
		end
	end)

	return { model = model, seat = seat, distance = (index - 1) / CHAIR_COUNT * totalLength }
end

-- Sucht einen wartenden Spieler auf der Einstiegsflaeche
local function findWaitingRider()
	local boardPosition = points[1]
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and not humanoid.Sit and not player:GetAttribute("Carrying") then
			local dx = root.Position.X - boardPosition.X
			local dz = root.Position.Z - boardPosition.Z
			if dx * dx + dz * dz <= BOARD_RADIUS * BOARD_RADIUS and root.Position.Y < 12 then
				return humanoid
			end
		end
	end
	return nil
end

function Lift.build(mapFolder)
	local folder = World.make("Folder", { Name = "Lift" }, mapFolder)
	buildPath()
	buildDecoration(folder)
	for i = 1, CHAIR_COUNT do
		chairs[i] = buildChair(folder, i)
	end
	Lift.update(0)
end

function Lift.update(dt)
	local step = LIFT_SPEED * dt
	for _, chair in ipairs(chairs) do
		local before = chair.distance
		local after = before + step
		local wrapped = after >= totalLength
		chair.distance = after % totalLength

		local position, direction = sample(chair.distance)
		local flat = Vector3.new(direction.X, 0, direction.Z)
		if flat.Magnitude < 0.001 then
			flat = Vector3.new(0, 0, 1)
		end
		chair.model:PivotTo(CFrame.lookAt(position, position + flat))

		-- Bergstation: Fahrgast steigt automatisch aus
		if before < topDistance and after >= topDistance then
			local occupant = chair.seat.Occupant
			if occupant then
				occupant.Sit = false
			end
		end

		-- Talstation: wartenden Spieler mitnehmen
		if wrapped and not chair.seat.Occupant then
			local humanoid = findWaitingRider()
			if humanoid then
				chair.seat:Sit(humanoid)
			end
		end
	end
end

return Lift
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Bases</string><ProtectedString name="Source"><![CDATA[-- Die Basen in der Lobby: jeder Spieler bekommt eine. Dort stehen seine Eier
-- und verdienen Geld. Andere Spieler koennen sie stehlen, solange die Basis
-- nicht gesperrt ist.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))

local Bases = {}

local BASE_SIZE = 60
local HALF = BASE_SIZE / 2
local BASE_CENTER_X = 115
local BASE_Z = { -160, -90, -20, 50 }

local bases = {}
local byPlayer = {}

Bases.notify = function() end -- wird von Main gesetzt

local function buildBase(folder, index, side, centerZ)
	local centerX = side * BASE_CENTER_X
	local model = World.make("Folder", { Name = "Base" .. index }, folder)

	World.part({
		Name = "Floor",
		Size = Vector3.new(BASE_SIZE, 0.4, BASE_SIZE),
		Position = Vector3.new(centerX, 0.2, centerZ),
		Color = Color3.fromRGB(70, 80, 110),
		Material = Enum.Material.Concrete,
	}, model)

	-- Rueckwand und Seitenwaende (vorne offen)
	local wallColor = Color3.fromRGB(50, 58, 85)
	World.part({
		Name = "BackWall",
		Size = Vector3.new(1, 12, BASE_SIZE),
		Position = Vector3.new(centerX + side * (HALF - 0.5), 6, centerZ),
		Color = wallColor,
	}, model)
	for _, zSide in ipairs({ -1, 1 }) do
		World.part({
			Name = "SideWall",
			Size = Vector3.new(BASE_SIZE, 12, 1),
			Position = Vector3.new(centerX, 6, centerZ + zSide * (HALF - 0.5)),
			Color = wallColor,
		}, model)
	end

	-- Podeste fuer die Eier: 2 Reihen mit je 4 Plaetzen
	local slotPositions = {}
	for row = 0, 1 do
		for column = 0, 3 do
			local x = centerX + side * (2 + row * 15)
			local z = centerZ - 19.5 + column * 13
			World.part({
				Name = "Pedestal",
				Size = Vector3.new(5, 2, 5),
				Position = Vector3.new(x, 1.4, z),
				Color = Color3.fromRGB(200, 205, 220),
				Material = Enum.Material.Marble,
			}, model)
			table.insert(slotPositions, Vector3.new(x, 2.4, z))
		end
	end

	-- Schild mit dem Namen des Besitzers
	local signPost = World.part({
		Name = "Sign",
		Size = Vector3.new(1, 1, 1),
		Position = Vector3.new(centerX - side * HALF, 14, centerZ),
		Transparency = 1,
		CanCollide = false,
	}, model)
	local label = World.billboard(signPost, "Empty Base", 30, 7, 0, Color3.new(1, 1, 1))

	-- Sperrflaeche am Eingang
	local lockPad = World.part({
		Name = "LockPad",
		Size = Vector3.new(7, 0.3, 7),
		Position = Vector3.new(centerX - side * (HALF - 6), 0.55, centerZ - HALF + 7),
		Color = Color3.fromRGB(255, 80, 80),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)
	local lockLabel = World.billboard(lockPad, "LOCK BASE", 10, 3, 4, Color3.fromRGB(255, 120, 120))

	-- Schutzschild, sichtbar solange die Basis gesperrt ist
	local shield = World.part({
		Name = "Shield",
		Size = Vector3.new(BASE_SIZE, 14, BASE_SIZE),
		Position = Vector3.new(centerX, 7, centerZ),
		Color = Color3.fromRGB(255, 60, 60),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	}, model)

	local base = {
		index = index,
		centerX = centerX,
		centerZ = centerZ,
		owner = nil,
		slots = {},
		slotPositions = slotPositions,
		lockedUntil = 0,
		label = label,
		lockLabel = lockLabel,
		shield = shield,
	}

	lockPad.Touched:Connect(function(hit)
		local owner = base.owner
		if not owner or not owner.Character then
			return
		end
		if not hit:IsDescendantOf(owner.Character) then
			return
		end
		if os.clock() < base.lockedUntil then
			return
		end
		base.lockedUntil = os.clock() + Config.LOCK_DURATION
		base.shield.Transparency = 0.6
		Bases.notify(owner, "Base locked for " .. Config.LOCK_DURATION .. " seconds!", "good")
	end)

	return base
end

function Bases.build(mapFolder)
	local folder = World.make("Folder", { Name = "Bases" }, mapFolder)
	local index = 0
	for _, side in ipairs({ -1, 1 }) do
		for _, centerZ in ipairs(BASE_Z) do
			index = index + 1
			bases[index] = buildBase(folder, index, side, centerZ)
		end
	end
end

function Bases.assign(player)
	for _, base in ipairs(bases) do
		if not base.owner then
			base.owner = player
			base.lockedUntil = 0
			base.label.Text = player.DisplayName .. "'s Base"
			byPlayer[player] = base
			return base
		end
	end
	return nil
end

function Bases.release(player)
	local base = byPlayer[player]
	if not base then
		return
	end
	base.owner = nil
	base.slots = {}
	base.lockedUntil = 0
	base.shield.Transparency = 1
	base.label.Text = "Empty Base"
	base.lockLabel.Text = "LOCK BASE"
	byPlayer[player] = nil
end

function Bases.of(player)
	return byPlayer[player]
end

function Bases.all()
	return bases
end

function Bases.isLocked(base)
	return os.clock() < base.lockedUntil
end

function Bases.contains(base, position)
	return math.abs(position.X - base.centerX) <= HALF
		and math.abs(position.Z - base.centerZ) <= HALF
		and position.Y < 20
end

function Bases.freeSlot(base)
	for slot = 1, Config.BASE_SLOTS do
		if not base.slots[slot] then
			return slot
		end
	end
	return nil
end

-- Einmal pro Sekunde: Anzeige der Sperrzeit aktualisieren
function Bases.tick()
	local now = os.clock()
	for _, base in ipairs(bases) do
		if base.owner then
			local remaining = base.lockedUntil - now
			if remaining > 0 then
				base.lockLabel.Text = "LOCKED " .. math.ceil(remaining) .. "s"
			else
				base.lockLabel.Text = "LOCK BASE"
				if base.shield.Transparency ~= 1 then
					base.shield.Transparency = 1
				end
			end
		end
	end
end

return Bases
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Spielstand: Geld, Geschwindigkeitsstufe, Wiedergeburten und Eier.
-- Wird dauerhaft gespeichert, sobald das Spiel veroeffentlicht ist und in Studio
-- unter "Game Settings > Security" der Zugriff auf API-Dienste erlaubt wurde.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Data = {}

local STORE_NAME = "SkiEggHeist_v1"
local profiles = {} -- [player] = Profil
local store = nil

-- Wird von Main gesetzt: liefert die aktuelle Ei-Liste eines Spielers
Data.collectEggs = nil

local function getStore()
	if store == nil then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(STORE_NAME)
		end)
		if ok then
			store = result
		else
			store = false
			warn("[Data] Speichern nicht verfuegbar: " .. tostring(result))
		end
	end
	return store or nil
end

local function publish(player, profile)
	player:SetAttribute("Cash", profile.Cash)
	player:SetAttribute("SpeedLevel", profile.SpeedLevel)
	player:SetAttribute("Rebirths", profile.Rebirths)
	player:SetAttribute("WalkSpeed", Config.walkSpeed(profile.SpeedLevel))
	player:SetAttribute("SkiSpeed", Config.skiSpeed(profile.SpeedLevel))

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local cash = stats:FindFirstChild("Cash")
		local rebirths = stats:FindFirstChild("Rebirths")
		if cash then
			cash.Value = math.floor(profile.Cash)
		end
		if rebirths then
			rebirths.Value = profile.Rebirths
		end
	end
end

function Data.load(player)
	local profile = { Cash = 0, SpeedLevel = 0, Rebirths = 0, Eggs = {}, canSave = false }

	local dataStore = getStore()
	if dataStore then
		local ok, saved = pcall(function()
			return dataStore:GetAsync("P_" .. player.UserId)
		end)
		if ok then
			profile.canSave = true
			if type(saved) == "table" then
				profile.Cash = tonumber(saved.Cash) or 0
				profile.SpeedLevel = math.min(tonumber(saved.SpeedLevel) or 0, Config.MAX_SPEED_LEVEL)
				profile.Rebirths = tonumber(saved.Rebirths) or 0
				if type(saved.Eggs) == "table" then
					for _, id in ipairs(saved.Eggs) do
						if Config.EGGS_BY_ID[id] then
							table.insert(profile.Eggs, id)
						end
					end
				end
			end
		else
			-- Laden fehlgeschlagen: nicht speichern, sonst wuerde der alte Stand ueberschrieben
			warn("[Data] Laden fehlgeschlagen fuer " .. player.Name .. ": " .. tostring(saved))
		end
	end

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = stats
	stats.Parent = player

	profiles[player] = profile
	publish(player, profile)
	return profile
end

function Data.get(player)
	return profiles[player]
end

function Data.save(player)
	local profile = profiles[player]
	if not profile or not profile.canSave then
		return
	end
	local dataStore = getStore()
	if not dataStore then
		return
	end
	if Data.collectEggs then
		profile.Eggs = Data.collectEggs(player)
	end
	local payload = {
		Cash = math.floor(profile.Cash),
		SpeedLevel = profile.SpeedLevel,
		Rebirths = profile.Rebirths,
		Eggs = profile.Eggs,
	}
	local ok, err = pcall(function()
		dataStore:SetAsync("P_" .. player.UserId, payload)
	end)
	if not ok then
		warn("[Data] Speichern fehlgeschlagen fuer " .. player.Name .. ": " .. tostring(err))
	end
end

function Data.release(player)
	profiles[player] = nil
end

function Data.saveAll()
	for _, player in ipairs(Players:GetPlayers()) do
		Data.save(player)
	end
end

function Data.addCash(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.Cash = profile.Cash + amount
	publish(player, profile)
end

-- Kauft die naechste Geschwindigkeitsstufe. Gibt true und einen Text zurueck.
function Data.buySpeed(player)
	local profile = profiles[player]
	if not profile then
		return false, ""
	end
	if profile.SpeedLevel >= Config.MAX_SPEED_LEVEL then
		return false, "Speed is already at maximum!"
	end
	local cost = Config.upgradeCost(profile.SpeedLevel)
	if profile.Cash < cost then
		return false, "Not enough cash! You need $" .. Config.formatNumber(cost)
	end
	profile.Cash = profile.Cash - cost
	profile.SpeedLevel = profile.SpeedLevel + 1
	publish(player, profile)
	return true, "Speed upgraded to level " .. profile.SpeedLevel .. "!"
end

-- Prueft und bezahlt die Wiedergeburt. Das Leeren der Basis uebernimmt Main.
function Data.rebirth(player)
	local profile = profiles[player]
	if not profile then
		return false, ""
	end
	local cost = Config.rebirthCost(profile.Rebirths)
	if profile.Cash < cost then
		return false, "Rebirth costs $" .. Config.formatNumber(cost)
	end
	profile.Cash = 0
	profile.SpeedLevel = 0
	profile.Rebirths = profile.Rebirths + 1
	profile.Eggs = {}
	publish(player, profile)
	return true, "Rebirth " .. profile.Rebirths .. "! Income x" .. Config.incomeMultiplier(profile.Rebirths)
end

return Data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Eggs</string><ProtectedString name="Source"><![CDATA[-- Herzstueck des Spiels: Nester, Eier, das Tragen und Abliefern, das Stehlen
-- aus fremden Basen und die Muetter, die den Dieb verfolgen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local World = require(script.Parent:WaitForChild("World"))
local Bases = require(script.Parent:WaitForChild("Bases"))
local Data = require(script.Parent:WaitForChild("Data"))

local Eggs = {}

Eggs.notify = function() end -- wird von Main gesetzt

local NEST_X = { -80, -58, -36, -14, 8, 30 }
local RETURN_SPEED = 160

local nests = {}
local carried = {} -- [player] = Ei-Datensatz
local lastFullWarning = {} -- [player] = Zeitpunkt der letzten "Basis voll"-Meldung
local eggFolder = nil

-- ---------------------------------------------------------------------------
-- Ei-Datensaetze
-- Zustand "Nest": liegt im Nest. "Carried": wird getragen. "Base": steht in einer Basis.
-- ---------------------------------------------------------------------------

local function eggSize(def)
	local scale = 1 + (def.zone - 1) * 0.15
	return Vector3.new(2.6 * scale, 3.4 * scale, 2.6 * scale)
end

local function onPrompt(record, player) end -- wird weiter unten definiert

local function createRecord(def)
	local size = eggSize(def)
	local part = World.part({
		Name = "Egg",
		Size = size,
		Color = def.color,
		Material = def.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		CanCollide = false,
		Massless = true,
	}, eggFolder)
	World.make("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, part)

	local income = "$" .. Config.formatNumber(def.income) .. "/s"
	World.billboard(part, def.name .. "\n" .. income, 9, 3, size.Y / 2 + 2, def.color)

	local prompt = World.make("ProximityPrompt", {
		ActionText = "Steal",
		ObjectText = def.name,
		HoldDuration = 0.3,
		MaxActivationDistance = 10,
		RequiresLineOfSight = false,
	}, part)

	local record = {
		def = def,
		part = part,
		prompt = prompt,
		state = "Nest",
		nest = nil,
		base = nil,
		slot = nil,
		carrier = nil,
		weld = nil,
	}

	prompt.Triggered:Connect(function(player)
		onPrompt(record, player)
	end)

	return record
end

local function detach(record)
	if record.weld then
		record.weld:Destroy()
		record.weld = nil
	end
	record.part.Anchored = true
	local player = record.carrier
	if player then
		if carried[player] == record then
			carried[player] = nil
		end
		player:SetAttribute("Carrying", nil)
		player:SetAttribute("Chased", nil)
		player:SetAttribute("MotherDistance", nil)
	end
	record.carrier = nil
end

local function attach(record, player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	record.state = "Carried"
	record.carrier = player
	carried[player] = record
	record.prompt.Enabled = false

	record.part.Anchored = false
	record.part.CFrame = root.CFrame * CFrame.new(0, 3 + record.part.Size.Y / 2, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = record.part
	weld.Parent = record.part
	record.weld = weld

	player:SetAttribute("Carrying", record.def.name)
	return true
end

local function toNest(record)
	local nest = record.nest
	detach(record)
	record.state = "Nest"
	record.part.CFrame = CFrame.new(nest.eggPosition + Vector3.new(0, record.part.Size.Y / 2, 0))
	record.part:SetAttribute("OwnerId", 0)
	record.prompt.HoldDuration = 0.3
	record.prompt.Enabled = true
	nest.egg = record
end

local function toSlot(record, base, slot)
	detach(record)
	if record.base and (record.base ~= base or record.slot ~= slot) then
		if record.base.slots[record.slot] == record then
			record.base.slots[record.slot] = nil
		end
	end
	record.nest = nil
	record.base = base
	record.slot = slot
	base.slots[slot] = record
	record.state = "Base"
	record.part.CFrame = CFrame.new(base.slotPositions[slot] + Vector3.new(0, record.part.Size.Y / 2, 0))
	record.part:SetAttribute("OwnerId", base.owner and base.owner.UserId or 0)
	record.prompt.HoldDuration = 1.2
	record.prompt.Enabled = true
end

local function destroyRecord(record)
	detach(record)
	if record.base and record.base.slots[record.slot] == record then
		record.base.slots[record.slot] = nil
	end
	record.base = nil
	record.state = "Gone"
	record.part:Destroy()
end

-- ---------------------------------------------------------------------------
-- Nester und Muetter
-- ---------------------------------------------------------------------------

local function pickEgg(zone)
	local total = 0
	for _, egg in ipairs(zone.eggs) do
		total = total + egg.weight
	end
	local roll = math.random() * total
	for _, egg in ipairs(zone.eggs) do
		roll = roll - egg.weight
		if roll <= 0 then
			return egg
		end
	end
	return zone.eggs[1]
end

local function spawnEgg(nest)
	local record = createRecord(pickEgg(nest.zone))
	record.nest = nest
	toNest(record)
end

local function buildMother(folder, zone)
	local info = zone.mother
	local s = info.size
	local model = Instance.new("Model")
	model.Name = info.name

	local function piece(name, size, offset, color, shape)
		return World.part({
			Name = name,
			Shape = shape or Enum.PartType.Block,
			Size = size * s,
			CFrame = CFrame.new(offset * s),
			Color = color,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
		}, model)
	end

	-- Blickrichtung des Modells ist -Z
	local body = piece("Body", Vector3.new(6, 6, 6), Vector3.new(0, 0, 0), info.color, Enum.PartType.Ball)
	piece("Head", Vector3.new(4, 4, 4), Vector3.new(0, 4, -2), info.color, Enum.PartType.Ball)
	piece("Beak", Vector3.new(1.2, 1, 2), Vector3.new(0, 3.8, -4.4), Color3.fromRGB(255, 170, 40))
	piece("EyeL", Vector3.new(0.8, 0.8, 0.8), Vector3.new(-1, 4.8, -3.6), Color3.fromRGB(255, 40, 40), Enum.PartType.Ball)
	piece("EyeR", Vector3.new(0.8, 0.8, 0.8), Vector3.new(1, 4.8, -3.6), Color3.fromRGB(255, 40, 40), Enum.PartType.Ball)
	piece("WingL", Vector3.new(1, 3.5, 4.5), Vector3.new(-3.3, 0.5, 0.3), info.color)
	piece("WingR", Vector3.new(1, 3.5, 4.5), Vector3.new(3.3, 0.5, 0.3), info.color)
	piece("Tail", Vector3.new(2.5, 2, 2), Vector3.new(0, 1.5, 3.5), info.color)
	piece("LegL", Vector3.new(0.7, 2.5, 0.7), Vector3.new(-1.2, -3.6, 0), Color3.fromRGB(255, 170, 40))
	piece("LegR", Vector3.new(0.7, 2.5, 0.7), Vector3.new(1.2, -3.6, 0), Color3.fromRGB(255, 170, 40))

	model.PrimaryPart = body
	World.billboard(body, info.name, 12 * s, 3 * s, 8 * s, Color3.fromRGB(255, 90, 90))
	model.Parent = folder
	return model
end

local function placeMother(nest, position, lookDirection)
	-- Die Fuesse stehen 4.85 * Groesse unter der Koerpermitte
	local y = Config.groundHeight(position.Z) + 4.85 * nest.zone.mother.size
	local center = Vector3.new(position.X, y, position.Z)
	local flat = Vector3.new(lookDirection.X, 0, lookDirection.Z)
	if flat.Magnitude < 0.001 then
		flat = Vector3.new(0, 0, -1)
	end
	nest.motherPosition = Vector3.new(position.X, 0, position.Z)
	nest.model:PivotTo(CFrame.lookAt(center, center + flat))
end

local function buildNests(mapFolder)
	local folder = World.make("Folder", { Name = "Nests" }, mapFolder)
	eggFolder = World.make("Folder", { Name = "Eggs" }, mapFolder)

	for zoneIndex, zone in ipairs(Config.ZONES) do
		local terraceZ, terraceY = Config.terraceStart(zoneIndex)
		local nestZ = terraceZ + Config.TERRACE_LENGTH / 2 - 5
		for _, x in ipairs(NEST_X) do
			World.part({
				Name = "Nest",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(1, 7, 7),
				CFrame = CFrame.new(x, terraceY + 0.5, nestZ) * CFrame.Angles(0, 0, math.rad(90)),
				Color = Color3.fromRGB(140, 105, 60),
				Material = Enum.Material.Wood,
				CanCollide = false,
			}, folder)

			local nest = {
				zone = zone,
				zoneIndex = zoneIndex,
				eggPosition = Vector3.new(x, terraceY + 1, nestZ),
				home = Vector3.new(x, 0, nestZ + 14),
				model = buildMother(folder, zone),
				motherPosition = Vector3.new(x, 0, nestZ + 14),
				motherState = "Idle",
				target = nil,
				targetRecord = nil,
				wakeAt = 0,
				egg = nil,
				respawnAt = nil,
			}
			placeMother(nest, nest.home, Vector3.new(0, 0, -1))
			table.insert(nests, nest)
			spawnEgg(nest)
		end
	end
end

local function stun(player)
	player:SetAttribute("Stunned", true)
	task.delay(Config.STUN_TIME, function()
		if player.Parent then
			player:SetAttribute("Stunned", nil)
		end
	end)
end

local function updateMother(nest, dt)
	local state = nest.motherState
	if state == "Idle" then
		return
	end

	if state == "Wake" then
		if os.clock() >= nest.wakeAt then
			nest.motherState = "Chase"
		end
		return
	end

	if state == "Chase" then
		local player = nest.target
		local record = nest.targetRecord
		local character = player and player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or record.carrier ~= player or record.state ~= "Carried" then
			nest.motherState = "Return"
			return
		end

		local targetPosition = root.Position
		if targetPosition.Z < Config.SLOPE_START_Z - 2 then
			-- Der Dieb hat die Lobby erreicht: entkommen
			player:SetAttribute("Chased", nil)
			player:SetAttribute("MotherDistance", nil)
			Eggs.notify(player, "You escaped the " .. nest.zone.mother.name .. "! Bring the egg to your base.", "good")
			nest.motherState = "Return"
			return
		end

		local flatTarget = Vector3.new(targetPosition.X, 0, targetPosition.Z)
		local offset = flatTarget - nest.motherPosition
		local distance = offset.Magnitude
		local catchRadius = 4 + 3 * nest.zone.mother.size
		local motherY = Config.groundHeight(nest.motherPosition.Z)

		if distance <= catchRadius and math.abs(targetPosition.Y - motherY) < 30 then
			toNest(record)
			stun(player)
			Eggs.notify(player, "The " .. nest.zone.mother.name .. " caught you and took her egg back!", "bad")
			nest.motherState = "Return"
			return
		end

		local step = math.min(nest.zone.mother.speed * dt, distance)
		local direction = offset.Unit
		placeMother(nest, nest.motherPosition + direction * step, direction)
		player:SetAttribute("MotherDistance", math.floor(distance))
		return
	end

	if state == "Return" then
		nest.target = nil
		nest.targetRecord = nil
		local offset = nest.home - nest.motherPosition
		local distance = offset.Magnitude
		if distance < 1 then
			placeMother(nest, nest.home, Vector3.new(0, 0, -1))
			nest.motherState = "Idle"
			return
		end
		local step = math.min(RETURN_SPEED * dt, distance)
		local direction = offset.Unit
		placeMother(nest, nest.motherPosition + direction * step, direction)
	end
end

-- ---------------------------------------------------------------------------
-- Aktionen der Spieler
-- ---------------------------------------------------------------------------

onPrompt = function(record, player)
	if record.state == "Nest" then
		if carried[player] then
			Eggs.notify(player, "You can only carry one egg at a time!", "bad")
			return
		end
		local nest = record.nest
		if not attach(record, player) then
			return
		end
		nest.egg = nil
		nest.respawnAt = nil
		nest.target = player
		nest.targetRecord = record
		nest.wakeAt = os.clock() + Config.MOTHER_WAKE_TIME
		nest.motherState = "Wake"
		player:SetAttribute("Chased", true)
		Eggs.notify(player, "The " .. nest.zone.mother.name .. " is angry! SKI DOWN!", "bad")
		return
	end

	if record.state == "Base" then
		local base = record.base
		local owner = base.owner

		if owner == player then
			-- Eigenes Ei verkaufen
			local value = record.def.income * Config.SELL_SECONDS
			destroyRecord(record)
			Data.addCash(player, value)
			Eggs.notify(player, "Sold " .. record.def.name .. " for $" .. Config.formatNumber(value), "good")
			return
		end

		if Bases.isLocked(base) then
			Eggs.notify(player, "This base is locked!", "bad")
			return
		end
		if carried[player] then
			Eggs.notify(player, "You can only carry one egg at a time!", "bad")
			return
		end
		if not Bases.of(player) then
			return
		end
		if attach(record, player) then
			Eggs.notify(player, "You stole a " .. record.def.name .. "! Run to your base!", "good")
			if owner then
				Eggs.notify(owner, player.DisplayName .. " is stealing your " .. record.def.name .. "! Touch them to get it back!", "bad")
			end
		end
	end
end

-- Ei verlieren (Tod, Verlassen des Spiels): zurueck dorthin, wo es herkam
function Eggs.drop(player)
	local record = carried[player]
	if not record then
		return
	end
	if record.nest then
		toNest(record)
	elseif record.base and record.base.owner then
		toSlot(record, record.base, record.slot)
	else
		destroyRecord(record)
	end
end

local function checkCarriers()
	for player, record in pairs(carried) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local position = root.Position
			local delivered = false

			-- Abliefern in der eigenen Basis
			local ownBase = Bases.of(player)
			if ownBase and Bases.contains(ownBase, position) then
				local slot = Bases.freeSlot(ownBase)
				if slot then
					local nest = record.nest
					if nest then
						nest.respawnAt = os.clock() + Config.NEST_RESPAWN
					end
					local victim = record.base and record.base.owner
					toSlot(record, ownBase, slot)
					delivered = true
					Eggs.notify(player, record.def.name .. " secured! +$" .. Config.formatNumber(record.def.income) .. "/s", "good")
					if victim and victim ~= player then
						Eggs.notify(victim, player.DisplayName .. " stole your " .. record.def.name .. "!", "bad")
					end
				else
					local now = os.clock()
					if not lastFullWarning[player] or now - lastFullWarning[player] > 4 then
						lastFullWarning[player] = now
						Eggs.notify(player, "Your base is full! Sell an egg first.", "bad")
					end
				end
			end

			-- Besitzer holt sein gestohlenes Ei zurueck
			if not delivered and record.base and record.base.owner and record.base.owner ~= player then
				local owner = record.base.owner
				local ownerRoot = owner.Character and owner.Character:FindFirstChild("HumanoidRootPart")
				if ownerRoot and (ownerRoot.Position - position).Magnitude <= Config.RECAPTURE_RADIUS then
					toSlot(record, record.base, record.slot)
					stun(player)
					Eggs.notify(owner, "You got your " .. record.def.name .. " back!", "good")
					Eggs.notify(player, owner.DisplayName .. " caught you!", "bad")
				end
			end
		end
	end
end

local function payIncome()
	for _, base in ipairs(Bases.all()) do
		local owner = base.owner
		if owner then
			local total = 0
			for slot = 1, Config.BASE_SLOTS do
				local record = base.slots[slot]
				if record and record.state == "Base" then
					total = total + record.def.income
				end
			end
			if total > 0 then
				local profile = Data.get(owner)
				if profile then
					Data.addCash(owner, total * Config.incomeMultiplier(profile.Rebirths))
				end
			end
		end
	end
end

-- ---------------------------------------------------------------------------
-- Schnittstelle fuer Main
-- ---------------------------------------------------------------------------

function Eggs.build(mapFolder)
	buildNests(mapFolder)
end

-- Gespeicherte Eier beim Betreten wieder in die Basis stellen
function Eggs.restore(player, eggIds)
	local base = Bases.of(player)
	if not base then
		return
	end
	for _, id in ipairs(eggIds) do
		local def = Config.EGGS_BY_ID[id]
		local slot = Bases.freeSlot(base)
		if def and slot then
			toSlot(createRecord(def), base, slot)
		end
	end
end

-- Liste der Eier, die einem Spieler gehoeren (zum Speichern)
function Eggs.listFor(player)
	local list = {}
	local base = Bases.of(player)
	if base then
		for slot = 1, Config.BASE_SLOTS do
			local record = base.slots[slot]
			if record then
				table.insert(list, record.def.id)
			end
		end
	end
	return list
end

-- Alle Eier einer Basis entfernen (Spieler geht oder macht eine Wiedergeburt)
function Eggs.clearBase(player)
	local base = Bases.of(player)
	if not base then
		return
	end
	for slot = 1, Config.BASE_SLOTS do
		local record = base.slots[slot]
		if record then
			local thief = record.carrier
			destroyRecord(record)
			if thief and thief ~= player then
				Eggs.notify(thief, "The owner left - the egg vanished.", "bad")
			end
		end
	end
end

function Eggs.forget(player)
	lastFullWarning[player] = nil
end

local carrierTimer = 0
local incomeTimer = 0

function Eggs.update(dt)
	local now = os.clock()
	for _, nest in ipairs(nests) do
		updateMother(nest, dt)
		if not nest.egg and nest.respawnAt and now >= nest.respawnAt and nest.motherState == "Idle" then
			nest.respawnAt = nil
			spawnEgg(nest)
		end
	end

	carrierTimer = carrierTimer + dt
	if carrierTimer >= 0.15 then
		carrierTimer = 0
		checkCarriers()
	end

	incomeTimer = incomeTimer + dt
	if incomeTimer >= 1 then
		incomeTimer = incomeTimer - 1
		payIncome()
		Bases.tick()
	end
end

return Eggs
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX17"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX16"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX15"><Properties><string name="Name">Client</string></Properties><Item class="LocalScript" referent="RBX14"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- Anzeige fuer den Spieler: Geld, Kaufknoepfe, Warnungen und Meldungen.
-- Ausserdem wird hier die Laufgeschwindigkeit gesetzt (bergab auf Schi schneller).

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local notifyRemote = remotes:WaitForChild("Notify")
local buySpeedRemote = remotes:WaitForChild("BuySpeed")
local rebirthRemote = remotes:WaitForChild("Rebirth")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function make(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		instance[key] = value
	end
	instance.Parent = parent
	return instance
end

local FONT = Enum.Font.FredokaOne

-- ---------------------------------------------------------------------------
-- Aufbau der Anzeige
-- ---------------------------------------------------------------------------
local gui = make("ScreenGui", {
	Name = "Hud",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
}, playerGui)

local cashLabel = make("TextLabel", {
	Name = "Cash",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0, 280, 0, 48),
	BackgroundColor3 = Color3.fromRGB(20, 30, 45),
	BackgroundTransparency = 0.25,
	Text = "$0",
	TextScaled = true,
	Font = FONT,
	TextColor3 = Color3.fromRGB(110, 255, 140),
}, gui)
make("UICorner", { CornerRadius = UDim.new(0, 12) }, cashLabel)

local statusLabel = make("TextLabel", {
	Name = "Status",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 62),
	Size = UDim2.new(0, 520, 0, 34),
	BackgroundTransparency = 1,
	Text = "",
	TextScaled = true,
	Font = FONT,
	TextColor3 = Color3.new(1, 1, 1),
	TextStrokeTransparency = 0,
}, gui)

local function makeButton(name, order, color)
	local button = make("TextButton", {
		Name = name,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, (order - 1) * 78 - 39),
		Size = UDim2.new(0, 200, 0, 68),
		BackgroundColor3 = color,
		Text = name,
		TextScaled = true,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		AutoButtonColor = true,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 12) }, button)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 6),
		PaddingLeft = UDim.new(0, 8),
		PaddingRight = UDim.new(0, 8),
	}, button)
	return button
end

local speedButton = makeButton("Speed", 1, Color3.fromRGB(40, 140, 255))
local rebirthButton = makeButton("Rebirth", 2, Color3.fromRGB(190, 80, 255))

local toastHolder = make("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -120),
	Size = UDim2.new(0, 480, 0, 200),
	BackgroundTransparency = 1,
}, gui)
make("UIListLayout", {
	FillDirection = Enum.FillDirection.Vertical,
	VerticalAlignment = Enum.VerticalAlignment.Bottom,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	SortOrder = Enum.SortOrder.LayoutOrder,
	Padding = UDim.new(0, 4),
}, toastHolder)

-- ---------------------------------------------------------------------------
-- Meldungen
-- ---------------------------------------------------------------------------
local TOAST_COLORS = {
	good = Color3.fromRGB(110, 255, 140),
	bad = Color3.fromRGB(255, 110, 110),
	info = Color3.fromRGB(255, 255, 255),
}
local toastCount = 0

local function showToast(text, kind)
	toastCount = toastCount + 1
	local label = make("TextLabel", {
		LayoutOrder = toastCount,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Color3.fromRGB(20, 30, 45),
		BackgroundTransparency = 0.3,
		Text = text,
		TextScaled = true,
		Font = FONT,
		TextColor3 = TOAST_COLORS[kind] or TOAST_COLORS.info,
	}, toastHolder)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, label)
	task.delay(4, function()
		local tween = TweenService:Create(label, TweenInfo.new(0.5), {
			TextTransparency = 1,
			BackgroundTransparency = 1,
		})
		tween:Play()
		task.wait(0.55)
		label:Destroy()
	end)
end

notifyRemote.OnClientEvent:Connect(showToast)

-- ---------------------------------------------------------------------------
-- Werte anzeigen
-- ---------------------------------------------------------------------------
local function refresh()
	local cash = player:GetAttribute("Cash") or 0
	local level = player:GetAttribute("SpeedLevel") or 0
	local rebirths = player:GetAttribute("Rebirths") or 0

	cashLabel.Text = "$" .. Config.formatNumber(cash)

	if level >= Config.MAX_SPEED_LEVEL then
		speedButton.Text = "SPEED MAX"
	else
		speedButton.Text = "SPEED Lv " .. level .. "\n$" .. Config.formatNumber(Config.upgradeCost(level))
	end
	rebirthButton.Text = "REBIRTH " .. rebirths .. "\n$" .. Config.formatNumber(Config.rebirthCost(rebirths))
end

local function refreshStatus()
	local carrying = player:GetAttribute("Carrying")
	local chased = player:GetAttribute("Chased")
	local distance = player:GetAttribute("MotherDistance")
	if player:GetAttribute("Stunned") then
		statusLabel.Text = "CAUGHT!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	elseif chased then
		if distance then
			statusLabel.Text = "THE MOTHER IS " .. distance .. " STUDS BEHIND YOU - SKI DOWN!"
		else
			statusLabel.Text = "THE MOTHER IS CHASING YOU - SKI DOWN!"
		end
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	elseif carrying then
		statusLabel.Text = "Carrying " .. carrying .. " - bring it to your base!"
		statusLabel.TextColor3 = Color3.fromRGB(255, 230, 110)
	else
		statusLabel.Text = ""
	end
end

for _, name in ipairs({ "Cash", "SpeedLevel", "Rebirths" }) do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
for _, name in ipairs({ "Carrying", "Chased", "MotherDistance", "Stunned" }) do
	player:GetAttributeChangedSignal(name):Connect(refreshStatus)
end
refresh()
refreshStatus()

speedButton.Activated:Connect(function()
	buySpeedRemote:FireServer()
end)
rebirthButton.Activated:Connect(function()
	rebirthRemote:FireServer()
end)

-- Beim eigenen Ei steht "Sell", bei fremden "Steal"
ProximityPromptService.PromptShown:Connect(function(prompt)
	local part = prompt.Parent
	if part and part.Name == "Egg" then
		if part:GetAttribute("OwnerId") == player.UserId then
			prompt.ActionText = "Sell"
		else
			prompt.ActionText = "Steal"
		end
	end
end)

-- ---------------------------------------------------------------------------
-- Geschwindigkeit: in der Lobby normal, bergab auf dem Berg mit Schi-Tempo
-- ---------------------------------------------------------------------------
RunService.Heartbeat:Connect(function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end

	local speed = player:GetAttribute("WalkSpeed") or 16
	if player:GetAttribute("Stunned") then
		speed = 0
	elseif root.Position.Z > Config.SLOPE_START_Z and humanoid.MoveDirection.Z < -0.3 then
		speed = player:GetAttribute("SkiSpeed") or 36
	end

	if humanoid.WalkSpeed ~= speed then
		humanoid.WalkSpeed = speed
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>